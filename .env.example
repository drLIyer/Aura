# Copy to .env for local development. Never commit .env or paste keys into chat or GitHub.

# Optional. Turns on Aura's AI features (Claude). Leave empty for basic mode, which needs no key.
# Get a key at https://platform.claude.com → API Keys (see "Turning on the AI features" in the README).
ANTHROPIC_API_KEY=

# Optional. Claude model for the AI features (default claude-opus-5-5).
# AURA_AI_MODEL=

# Optional. Wearable connections through an Open Wearables gateway.
# OPEN_WEARABLES_URL=
# OPEN_WEARABLES_API_KEY=
